# 用法：cp env.example .env，再填。.env 不進 git。

# PostgreSQL 在這台主機上就用 localhost
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zentra
PG_SSLMODE=disable

# 唯讀監控帳號（建法見 monitoring/README.md），不要用平台的 zentra 帳號
PG_MONITOR_USER=zentra_monitor
PG_MONITOR_PASSWORD=

# 9100 被別的程式占了才改（監控主機 prometheus.yml 的 node 目標要一起改）
# NODE_EXPORTER_PORT=9100
