# 用法：cp env.example .env，再填。.env 不進 git。

# DB 還在 AP 主機上：host.docker.internal（連回這台主機的 5432）
# DB 拆出去之後：localhost 或 DB 主機 IP
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=zentra
PG_SSLMODE=disable

# 正式環境請建一個只能「看」的監控帳號，不要用平台的 zentra 帳號（建法見 monitoring/README.md）。
# 本機練習可以先用 zentra / zentra。
PG_MONITOR_USER=zentra_monitor
PG_MONITOR_PASSWORD=
