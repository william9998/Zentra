    {
      "type": "stat",
      "title": "失聯的監控目標",
      "description": "0 才正常。>0 去 Prometheus 的 Targets 頁看是哪個",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up == 0) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
