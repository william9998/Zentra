# 複製成 .env 後再改。.env 不會被提交（見 .gitignore）。
#
#   cp .env.example .env
#
# 這份列出 compose.yaml 讀得到的**全部**變數。留空的那些是選填，
# 但下面各段會寫清楚「不填會怎樣」——不填不會靜默降級，只會在該失敗的地方失敗。

ZENTRA_ENV=dev

# ── 資料層 ────────────────────────────────────────────────────────
POSTGRES_USER=zentra
POSTGRES_PASSWORD=zentra
POSTGRES_DB=zentra

# app / worker 用。主機名是 compose 的服務名，不是 localhost。
DATABASE_URL=postgresql://zentra:zentra@postgres:5432/zentra
REDIS_URL=redis://redis:6379/0

# ── 沙盒（P4：這裡不放任何長期憑證）──────────────────────────────
#
# ⚠️ SANDBOX_GATEWAY_URL 的主機名必須是 **app**（服務於 2026-09-25 由 api 更名，
#    ADR-0009 R3 之後的那次改名）。寫成 api 的話沙盒解析不到主機，
#    症狀是 Run 直接 FAILED、SANDBOX_ERROR、訊息含 "name resolution"，
#    而所有服務看起來都健康——症狀不指向原因。
SANDBOX_NETWORK=zentra-sandbox-net
SANDBOX_GATEWAY_URL=http://app:8000/internal
# 一次性沙盒（常駐容器起不來時的退路）同時最多幾個
SANDBOX_MAX_CONCURRENT=10

# ── 常駐容器（每個版本一個，見 specs/dispatcher-resources.md）────────
#
# 一個容器同時跑幾筆 Run，多的在 Redis 排隊。這 N 筆共用容器的 2 GB ——
# 每筆 Run 會在記憶體裡留很多資料（文件、對話歷史）的話，要調小。
SANDBOX_RUNS_PER_CONTAINER=50
# 排隊最多等幾秒，超過就 FAILED（排隊時間不算進 Run 自己的逾時）
RUN_QUEUE_TIMEOUT_SECONDS=3600
# 閒置幾秒就回收容器。不要設 0：容器是自動啟動的，0 = 永遠不回收
CONTAINER_IDLE_TIMEOUT_SECONDS=1800
# 容器啟動最多等幾秒，超過就退回一次性沙盒
CONTAINER_START_TIMEOUT_SECONDS=180

# ── app 的行程數與資料庫連線 ─────────────────────────────────────
#
# app 開幾個行程。一個行程最多吃滿一顆 CPU，長輸入多時 app 會是瓶頸。
# 4 核心的主機 2 就夠（再多換 Postgres 卡住）；主機核心多才調大，最多 5。
APP_WORKERS=2
# 「每個」app 行程的連線池。總數 = APP_WORKERS ×（SIZE + OVERFLOW），
# 加上 worker 的 10 條，要低於 Postgres 的上限 100。通常不用動。
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── LLM（ZEN-002）─────────────────────────────────────────────────
#
# 平台級金鑰：沒有自己憑證的 Agent 會用這把。
# **只宣告在 app 服務上**（見 compose.yaml）。worker 是注入沙盒 env 的那一個，
# 它手上沒有這些變數，所以金鑰不可能進沙盒——這不是靠紀律，是靠「沒有」。
#
# 不填會怎樣：沒有自己憑證的 Agent 呼叫 LLM 時回 LLM_ERROR，訊息直說沒設定。
# 只用 per-agent 憑證的話可以留空。
ZENTRA_LLM_API_KEY=
ZENTRA_LLM_BASE_URL=https://api.openai.com/v1
ZENTRA_LLM_DEFAULT_MODEL=gpt-4o-mini

# ── per-agent 憑證的靜態加密（ZEN-012）───────────────────────────
#
# 產生一把：
#   docker run --rm zentra-app:latest python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 不填會怎樣：平台**拒絕儲存**任何 Agent 憑證（回 422），不會退而存明文。
#
# ⚠️ 換掉或弄丟它，既有的 Agent 憑證全部永久解不開——它就是那些憑證的鎖。
#    屆時要重新在 Console 輸入一次金鑰。
ZENTRA_SECRET_KEY=

# ── 內部 Registry 的位址 ─────────────────────────────────────────
#
# 兩個視角看同一個 registry：image_ref 裡寫的是主機看到的位址，
# worker 刪 image 時是從 compose 網路裡面連。通常不用動。
INTERNAL_REGISTRY_HOST=localhost:6000
INTERNAL_REGISTRY_URL=http://registry:5000

# ── 外部 Registry 認證（選填）────────────────────────────────────
#
# 只有要從**需要登入的**外部 Registry 拉 image 才需要。
# 本機的 localhost:6000 與公開的 Docker Hub / GHCR 都不用。
# 指向一份 Docker config JSON：{"auths":{"<registry>":{"auth":"<base64>"}}}
# ZENTRA_REGISTRY_AUTH_FILE=/absolute/path/to/registry-auth.json
